BLENDER="D:\Blender\blender.exe"
DIST=../dist

all : \
    $(DIST)/silverstone.pnct \
    $(DIST)/silverstone.scene \
    $(DIST)/silverstone.track \
    $(DIST)/hexapod.pnct \
    $(DIST)/hexapod.scene \

#the circuit and balls are generated by a Blender script; it writes both the .blend and the centre line used by the physics:
silverstone.blend $(DIST)/silverstone.track : make-silverstone.py
    $(BLENDER) --background --python make-silverstone.py -- silverstone.blend "$(DIST)/silverstone.track"

$(DIST)/silverstone.scene : silverstone.blend export-scene.py
    $(BLENDER) --background --python export-scene.py -- "silverstone.blend:Main" "$(DIST)/silverstone.scene"

$(DIST)/silverstone.pnct : silverstone.blend export-meshes.py
    $(BLENDER) --background --python export-meshes.py -- "silverstone.blend:Main" "$(DIST)/silverstone.pnct"

$(DIST)/hexapod.scene : hexapod.blend export-scene.py
    $(BLENDER) --background --python export-scene.py -- "hexapod.blend:Main" "$(DIST)/hexapod.scene"

$(DIST)/hexapod.pnct : hexapod.blend export-meshes.py
    $(BLENDER) --background --python export-meshes.py -- "hexapod.blend:Main" "$(DIST)/hexapod.pnct" 
